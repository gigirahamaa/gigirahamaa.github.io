<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Heartbleed & Open-Source Security | Rahama Much</title>
  <style>
    /* ================= PURPLE CYBERSECURITY THEME ================= */
    :root {
      --bg: #faf7ff;
      --surface: #ffffff;
      --surface-alt: #f3e8ff;
      --text: #1c162e;
      --text-muted: #584c75;
      --primary: #7c3aed;       /* Royal Purple */
      --primary-hover: #6d28d9;
      --accent: #c026d3;        /* Magenta-Purple */
      --border: #ddd6fe;
      --danger-bg: #fee2e2;
      --danger-text: #991b1b;
      --safe-bg: #dcfce7;
      --safe-text: #166534;
      --shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.12);
    }

    [data-theme="dark"] {
      --bg: #090512;            /* Deep Void Purple */
      --surface: #130c21;       /* Card Surface */
      --surface-alt: #21143b;   /* Highlight Box */
      --text: #f5f3ff;
      --text-muted: #b4a5d6;
      --primary: #a855f7;       /* Neon Purple */
      --primary-hover: #c084fc;
      --accent: #e879f9;        /* Glowing Orchid */
      --border: #36235c;
      --danger-bg: #3b1219;
      --danger-text: #fca5a5;
      --safe-bg: #0f2e1d;
      --safe-text: #86efac;
      --shadow: 0 12px 32px -5px rgba(0, 0, 0, 0.7);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.65;
      transition: background-color 0.25s ease, color 0.25s ease;
      overflow-x: hidden;
    }

    /* Ambient Purple Glow Background */
    body::before {
      content: "";
      position: fixed;
      top: -150px;
      left: 50%;
      transform: translateX(-50%);
      width: 750px;
      height: 450px;
      background: radial-gradient(circle, rgba(168, 85, 247, 0.16) 0%, transparent 70%);
      pointer-events: none;
      z-index: -1;
    }

    /* ================= TOP READING BAR ================= */
    #scrollBar {
      position: fixed;
      top: 0;
      left: 0;
      height: 4px;
      width: 0%;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      z-index: 999;
      transition: width 0.1s ease;
    }

    /* ================= NAVBAR ================= */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1050px;
      margin: 0 auto;
      padding: 0.9rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .logo {
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--primary);
      text-decoration: none;
      letter-spacing: -0.02em;
    }

    nav {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: center;
    }

    nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      transition: color 0.2s;
    }

    nav a:hover {
      color: var(--primary);
    }

    .theme-btn {
      background: var(--surface-alt);
      color: var(--primary);
      border: 1px solid var(--border);
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .theme-btn:hover {
      background: var(--primary);
      color: #fff;
    }

    /* ================= HERO SECTION ================= */
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 5rem;
    }

    .hero {
      background: linear-gradient(135deg, var(--surface) 0%, var(--surface-alt) 100%);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 2.5rem;
      box-shadow: var(--shadow);
      margin-bottom: 2.2rem;
    }

    .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.2rem;
    }

    .badge {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--primary);
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
    }

    h1 {
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      line-height: 1.15;
      margin-bottom: 0.6rem;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 1.05rem;
      margin-bottom: 1.5rem;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.85rem;
      margin-top: 1.4rem;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.9rem 1rem;
      border-radius: 14px;
      text-align: center;
    }

    .stat-card .num {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--primary);
      display: block;
    }

    .stat-card .label {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* ================= SECTIONS & CARDS ================= */
    section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
    }

    h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    h3 {
      font-size: 1.15rem;
      margin: 1.4rem 0 0.6rem;
      color: var(--text);
    }

    p {
      margin-bottom: 1rem;
    }

    .callout {
      background: var(--surface-alt);
      border-left: 4px solid var(--primary);
      padding: 1.1rem 1.3rem;
      border-radius: 0 12px 12px 0;
      margin: 1.2rem 0;
    }

    .two-col {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 1.2rem;
      margin: 1.2rem 0;
    }

    .mini-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.2rem;
    }

    .mini-card h4 {
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    ul {
      padding-left: 1.3rem;
      margin-bottom: 1rem;
    }

    li {
      margin-bottom: 0.45rem;
    }

    /* ================= INTERACTIVE TIMELINE ================= */
    .timeline {
      border-left: 3px solid var(--primary);
      margin-left: 0.6rem;
      padding-left: 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .tl-item {
      position: relative;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.2rem;
    }

    .tl-item::before {
      content: "";
      position: absolute;
      left: -1.85rem;
      top: 1.2rem;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      border: 3px solid var(--bg);
    }

    .tl-date {
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* ================= CODE COMPARISON TABS ================= */
    .tab-buttons {
      display: flex;
      gap: 0.6rem;
      margin-bottom: 0.8rem;
    }

    .tab-btn {
      background: var(--bg);
      color: var(--text-muted);
      border: 1px solid var(--border);
      padding: 0.5rem 1rem;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
    }

    .tab-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .code-block {
      background: #09050f;
      color: #e9d5ff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.1rem;
      font-family: "Fira Code", Consolas, monospace;
      font-size: 0.85rem;
      overflow-x: auto;
      white-space: pre;
    }

    /* ================= INTERACTIVE HEARTBEAT SIMULATOR ================= */
    .sim-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.4rem;
      margin-top: 1rem;
    }

    .sim-controls {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .btn {
      padding: 0.6rem 1.1rem;
      border-radius: 10px;
      border: none;
      font-weight: 700;
      cursor: pointer;
      font-size: 0.88rem;
      transition: transform 0.15s, opacity 0.2s;
    }

    .btn:hover {
      transform: translateY(-1px);
      opacity: 0.92;
    }

    .btn-safe {
      background: var(--primary);
      color: #fff;
    }

    .btn-attack {
      background: #dc2626;
      color: #fff;
    }

    .terminal {
      font-family: "Fira Code", Consolas, monospace;
      font-size: 0.86rem;
      padding: 1rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #09050f;
      color: #e9d5ff;
      white-space: pre-wrap;
    }

    /* ================= INTERACTIVE CHECKLIST ================= */
    .checklist label {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 0.85rem 1rem;
      border-radius: 10px;
      margin-bottom: 0.65rem;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    .checklist label:hover {
      border-color: var(--primary);
    }

    .checklist input[type="checkbox"] {
      accent-color: var(--primary);
